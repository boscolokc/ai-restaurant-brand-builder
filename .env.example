# Prisma datasource
#
# Local demo default (SQLite) — copy this file to `.env`:
DATABASE_URL="file:./dev.db"
#
# Production (Bosco lock): Prisma + PostgreSQL. Prisma cannot switch providers
# from the URL alone. In prisma/schema.prisma change:
#
#   datasource db {
#     provider = "postgresql"
#     url      = env("DATABASE_URL")
#   }
#
# Then set:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hearth?schema=public"
#
# Models stay the same. `npm install && npm run build` must keep working on SQLite.
